# Copy to scripts/relay/.env (gitignored) and fill in locally. NEVER commit .env.
# The key is read from the environment only; relay.py never prints it.
ANTHROPIC_API_KEY=
# Required, no default: choose the model explicitly (see https://docs.anthropic.com/en/api/messages).
ANTHROPIC_MODEL=
# Required, no default: API version header value. The API docs list dated versions
# (2023-06-01 was listed on 2026-10-23); pick one deliberately.
ANTHROPIC_VERSION=
# Optional
ANTHROPIC_MAX_TOKENS=8000
